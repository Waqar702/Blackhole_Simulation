#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) writeonly uniform image2D outImage;
layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    bool moving;
    int   _pad4;
} cam;

layout(std140, binding = 2) uniform Disk {
    float disk_r1;
    float disk_r2;
    float disk_num;
    float thickness;
};

layout(std140, binding = 3) uniform Objects {
    int numObjects;
    vec4 objPosRadius[16];
    vec4 objColor[16];
    float  mass[16]; 
};

const float SagA_rs = 1.269e10;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= 800 || pix.y >= 600) return;

    vec4 color = vec4(0.0);
    
    // Start with starfield background
    float noise = fract(sin(dot(vec2(pix), vec2(12.9898, 78.233))) * 43758.5453);
    if (noise > 0.995) {
        color = vec4(1.0, 1.0, 1.0, 1.0);  // White stars
    } else {
        color = vec4(0.0, 0.0, 0.3, 1.0);  // Dark blue background
    }
    
    // Calculate ray direction from camera
    float u = (2.0 * (pix.x + 0.5) / 800.0 - 1.0) * cam.aspect * cam.tanHalfFov;
    float v = (1.0 - 2.0 * (pix.y + 0.5) / 600.0) * cam.tanHalfFov;
    vec3 rayDir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);
    
    // Project black hole position to screen space
    vec3 blackHolePos = vec3(0.0, 0.0, 0.0);  // Black hole at origin
    vec3 toBH = blackHolePos - cam.camPos;
    float distToBH = length(toBH);
    
    // Check if black hole is in front of camera
    if (dot(rayDir, toBH) > 0.0) {
        // Project black hole to screen
        float t = dot(toBH, rayDir);
        vec3 projectedPos = cam.camPos + t * rayDir;
        vec3 screenOffset = projectedPos - blackHolePos;
        
        // Convert to screen coordinates
        float screenX = dot(screenOffset, cam.camRight) * 100.0 + 400.0;
        float screenY = dot(screenOffset, cam.camUp) * 100.0 + 300.0;
        
        // Draw black hole if it's on screen
        if (screenX > 0.0 && screenX < 800.0 && screenY > 0.0 && screenY < 600.0) {
            vec2 center = vec2(screenX, screenY);
            vec2 pos = vec2(pix.x, pix.y);
            float distToCenter = length(pos - center);
            
            // Black hole radius in screen space (scaled by distance)
            float bhScreenRadius = 50.0 * (1e11 / distToBH);  // Scale by distance
            
            if (distToCenter < bhScreenRadius) {
                color = vec4(0.0, 0.0, 0.0, 1.0);  // Black hole
            }
        }
    }
    
    // Draw accretion disk
    // Project disk to screen space
    vec3 diskCenter = vec3(0.0, 0.0, 0.0);
    vec3 toDisk = diskCenter - cam.camPos;
    
    if (dot(rayDir, toDisk) > 0.0) {
        float t = dot(toDisk, rayDir);
        vec3 projectedPos = cam.camPos + t * rayDir;
        vec3 screenOffset = projectedPos - diskCenter;
        
        // Convert to screen coordinates
        float screenX = dot(screenOffset, cam.camRight) * 100.0 + 400.0;
        float screenY = dot(screenOffset, cam.camUp) * 100.0 + 300.0;
        
        // Draw disk if it's on screen
        if (screenX > 0.0 && screenX < 800.0 && screenY > 0.0 && screenY < 600.0) {
            vec2 pos = vec2(pix.x, pix.y);
            float distToDiskY = abs(pos.y - screenY);
            float diskThickness = 10.0 * (1e11 / distToBH);  // Scale by distance
            
            if (distToDiskY < diskThickness && pos.x > 200.0 && pos.x < 600.0) {
                float r = (pos.x - 200.0) / 400.0;  // Normalize to 0-1
                color = vec4(1.0, 0.3 + 0.7 * r, 0.1, 1.0);  // Orange disk
            }
        }
    }
    
    // Add multiple light rays with better curvature
    vec2 screenPos = vec2(pix.x, pix.y);
    
    // Create multiple horizontal light rays at different heights
    for (int ray = 0; ray < 8; ++ray) {
        float rayY = 100.0 + float(ray) * 60.0;  // Rays at y=100, 160, 220, etc.
        
        // Check if this pixel is near a ray path
        float distToRay = abs(screenPos.y - rayY);
        if (distToRay < 3.0 && screenPos.x > 50 && screenPos.x < 750) {
            // Better gravitational lensing effect
            float centerX = 400.0;  // Center of screen
            float distFromCenter = abs(screenPos.x - centerX);
            float curvature = 0.0;
            
            // More realistic gravitational lensing
            if (distFromCenter < 150.0) {
                float bhInfluence = 1.0 - (distFromCenter / 150.0);
                // Smooth curve that bends toward the black hole
                curvature = bhInfluence * bhInfluence * 15.0 * sin((screenPos.x - centerX) * 0.02);
            }
            
            float curvedY = rayY + curvature;
            float distToCurvedRay = abs(screenPos.y - curvedY);
            
            if (distToCurvedRay < 2.0) {
                // Make rays more visible
                color.rgb = max(color.rgb, vec3(0.8, 0.9, 1.0));
            }
        }
    }
    
    imageStore(outImage, pix, color);
}
