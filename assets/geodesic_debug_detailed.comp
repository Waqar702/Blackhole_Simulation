#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) writeonly uniform image2D outImage;
layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    bool moving;
    int   _pad4;
} cam;

layout(std140, binding = 2) uniform Disk {
    float disk_r1;
    float disk_r2;
    float disk_num;
    float thickness;
};

layout(std140, binding = 3) uniform Objects {
    int numObjects;
    vec4 objPosRadius[16];
    vec4 objColor[16];
    float  mass[16]; 
};

const float SagA_rs = 1.269e10;
const float D_LAMBDA = 1e6;
const double ESCAPE_R = 1e14;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= 400 || pix.y >= 300) return;

    // Init Ray
    float u = (2.0 * (pix.x + 0.5) / 400.0 - 1.0) * cam.aspect * cam.tanHalfFov;
    float v = (1.0 - 2.0 * (pix.y + 0.5) / 300.0) * cam.tanHalfFov;
    vec3 dir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);
    
    // Show ray direction as color (debug)
    vec4 color = vec4(abs(dir), 1.0);
    
    // Check if we're looking at the black hole
    vec3 camToBH = normalize(-cam.camPos);  // Direction to black hole center
    float dotProduct = dot(dir, camToBH);
    
    if (dotProduct > 0.9) {  // Looking roughly at black hole
        color = vec4(1.0, 0.0, 0.0, 1.0);  // Red for black hole direction
    }
    
    // Check disk intersection
    if (disk_r2 > 0.0) {
        float disk_center_dist = length(cam.camPos) / disk_r2;
        if (disk_center_dist > 0.8 && disk_center_dist < 1.2) {
            color = mix(color, vec4(0.0, 1.0, 0.0, 1.0), 0.5);  // Green for disk region
        }
    }
    
    // Show camera distance as brightness
    float cam_dist = length(cam.camPos);
    float dist_factor = min(cam_dist / 1e11, 1.0);
    color.rgb *= dist_factor;
    
    // Add some noise so we can see it's working
    float noise = fract(sin(dot(vec2(pix), vec2(12.9898, 78.233))) * 43758.5453);
    color.rgb += vec3(noise * 0.1);
    
    // Ensure minimum brightness
    color = max(color, vec4(0.1, 0.1, 0.1, 1.0));
    
    imageStore(outImage, pix, color);
}
