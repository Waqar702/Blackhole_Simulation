#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) writeonly uniform image2D outImage;
layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    bool moving;
    int   _pad4;
} cam;

layout(std140, binding = 2) uniform Disk {
    float disk_r1;
    float disk_r2;
    float disk_num;
    float thickness;
};

layout(std140, binding = 3) uniform Objects {
    int numObjects;
    vec4 objPosRadius[16];
    vec4 objColor[16];
    float  mass[16]; 
};

const float SagA_rs = 1.269e10;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= 400 || pix.y >= 300) return;

    // Init Ray
    float u = (2.0 * (pix.x + 0.5) / 400.0 - 1.0) * cam.aspect * cam.tanHalfFov;
    float v = (1.0 - 2.0 * (pix.y + 0.5) / 300.0) * cam.tanHalfFov;
    vec3 dir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);
    
    vec4 color = vec4(0.0);
    
    // Simple ray marching to black hole
    vec3 rayPos = cam.camPos;
    float stepSize = 1e9;  // Large step size
    bool hitSomething = false;
    
    for (int i = 0; i < 200; ++i) {
        float distToOrigin = length(rayPos);
        
        // Check if we hit the black hole
        if (distToOrigin <= SagA_rs) {
            color = vec4(0.0, 0.0, 0.0, 1.0);  // Black hole
            hitSomething = true;
            break;
        }
        
        // Check if we hit the accretion disk (simple plane at y=0)
        // Only check if we're close to the disk plane
        if (abs(rayPos.y) < stepSize && distToOrigin >= disk_r1 && distToOrigin <= disk_r2) {
            float r = distToOrigin / disk_r2;
            // Make the disk more orange/red and add some variation
            vec3 diskColor = vec3(1.0, 0.3 + 0.7 * r, 0.1);
            color = vec4(diskColor, 1.0);  // Orange/red disk
            hitSomething = true;
            break;
        }
        
        // March ray forward
        rayPos += dir * stepSize;
        
        // Check if we've gone too far
        if (distToOrigin > 1e12) break;
    }
    
    // If we didn't hit anything, show starfield
    if (!hitSomething) {
        // Create starfield with FEWER stars (less cluttered)
        float noise = fract(sin(dot(vec2(pix), vec2(12.9898, 78.233))) * 43758.5453);
        if (noise > 0.995) {  // Reduced from 0.98 to 0.995 (fewer stars)
            color = vec4(1.0, 1.0, 1.0, 1.0);  // White stars
        } else {
            color = vec4(0.0, 0.0, 0.3, 1.0);  // Dark blue background
        }
    }
    
    imageStore(outImage, pix, color);
}
