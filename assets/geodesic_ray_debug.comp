#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) writeonly uniform image2D outImage;
layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    bool moving;
    int   _pad4;
} cam;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= 400 || pix.y >= 300) return;

    // Init Ray
    float u = (2.0 * (pix.x + 0.5) / 400.0 - 1.0) * cam.aspect * cam.tanHalfFov;
    float v = (1.0 - 2.0 * (pix.y + 0.5) / 300.0) * cam.tanHalfFov;
    vec3 dir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);
    
    // Show ray direction as color
    vec4 color = vec4(abs(dir), 1.0);
    
    // Show camera position info
    if (pix.x < 50 && pix.y < 50) {  // Top-left corner
        color = vec4(1.0, 0.0, 0.0, 1.0);  // Red square
    }
    
    // Show ray direction magnitude
    float dir_mag = length(dir);
    if (dir_mag < 0.9 || dir_mag > 1.1) {
        color = vec4(1.0, 1.0, 0.0, 1.0);  // Yellow for invalid directions
    }
    
    // Show center pixel
    if (pix.x == 200 && pix.y == 150) {
        color = vec4(0.0, 1.0, 0.0, 1.0);  // Green for center
    }
    
    imageStore(outImage, pix, color);
}
