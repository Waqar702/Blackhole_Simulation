#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) writeonly uniform image2D outImage;
layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    bool moving;
    int   _pad4;
} cam;

layout(std140, binding = 2) uniform Disk {
    float disk_r1;
    float disk_r2;
    float disk_num;
    float thickness;
};

layout(std140, binding = 3) uniform Objects {
    int numObjects;
    vec4 objPosRadius[16];
    vec4 objColor[16];
    float  mass[16]; 
};

const float SagA_rs = 1.269e10;
const float D_LAMBDA = 1e8;  // Step size for ray marching

// Simple RK4 integration for geodesics
vec3 geodesicRHS(vec3 pos, vec3 vel) {
    float r = length(pos);
    if (r <= SagA_rs) return vec3(0.0);  // Inside black hole
    
    float f = 1.0 - SagA_rs / r;
    vec3 accel = -(SagA_rs / (2.0 * r * r * r)) * pos * f;
    return accel;
}

vec3 rk4Step(vec3 pos, vec3 vel, float dt) {
    vec3 k1v = geodesicRHS(pos, vel);
    vec3 k1p = vel;
    
    vec3 k2v = geodesicRHS(pos + 0.5 * dt * k1p, vel + 0.5 * dt * k1v);
    vec3 k2p = vel + 0.5 * dt * k1v;
    
    vec3 k3v = geodesicRHS(pos + 0.5 * dt * k2p, vel + 0.5 * dt * k2v);
    vec3 k3p = vel + 0.5 * dt * k2v;
    
    vec3 k4v = geodesicRHS(pos + dt * k3p, vel + dt * k3v);
    vec3 k4p = vel + dt * k3v;
    
    vec3 newPos = pos + (dt / 6.0) * (k1p + 2.0 * k2p + 2.0 * k3p + k4p);
    vec3 newVel = vel + (dt / 6.0) * (k1v + 2.0 * k2v + 2.0 * k3v + k4v);
    
    return newPos;
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= 800 || pix.y >= 600) return;

    // Init Ray
    float u = (2.0 * (pix.x + 0.5) / 800.0 - 1.0) * cam.aspect * cam.tanHalfFov;
    float v = (1.0 - 2.0 * (pix.y + 0.5) / 600.0) * cam.tanHalfFov;
    vec3 dir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);
    
    vec4 color = vec4(0.0);
    
    // Start ray from camera
    vec3 rayPos = cam.camPos;
    vec3 rayVel = dir;  // Light rays travel at speed of light
    
    // Ray march with geodesic integration
    bool hitBlackHole = false;
    bool hitDisk = false;
    vec3 lastPos = rayPos;
    
    for (int i = 0; i < 1000; ++i) {
        float distToOrigin = length(rayPos);
        
        // Check if we hit the black hole
        if (distToOrigin <= SagA_rs) {
            hitBlackHole = true;
            break;
        }
        
        // Check if we hit the accretion disk (y=0 plane)
        if (abs(rayPos.y) < 1e9 && distToOrigin >= disk_r1 && distToOrigin <= disk_r2) {
            hitDisk = true;
            break;
        }
        
        // Store previous position for ray drawing
        lastPos = rayPos;
        
        // Integrate geodesic
        vec3 newPos = rk4Step(rayPos, rayVel, D_LAMBDA);
        rayVel = normalize(newPos - rayPos) * length(rayVel);
        rayPos = newPos;
        
        // Check if we've gone too far
        if (distToOrigin > 1e12) break;
    }
    
    // Color based on what we hit
    if (hitBlackHole) {
        color = vec4(0.0, 0.0, 0.0, 1.0);  // Black hole
    } else if (hitDisk) {
        float r = length(rayPos) / disk_r2;
        color = vec4(1.0, 0.3 + 0.7 * r, 0.1, 1.0);  // Orange disk
    } else {
        // Show starfield with fewer stars
        float noise = fract(sin(dot(vec2(pix), vec2(12.9898, 78.233))) * 43758.5453);
        if (noise > 0.995) {
            color = vec4(1.0, 1.0, 1.0, 1.0);  // White stars
        } else {
            color = vec4(0.0, 0.0, 0.3, 1.0);  // Dark blue background
        }
    }
    
    // Add ray visualization - draw rays as bright lines
    // This is a simplified approach - in a real implementation, we'd store ray paths
    float rayIntensity = 0.0;
    
    // Check if this pixel is near a ray path (simplified)
    float distToRay = abs(pix.y - 300.0);  // Horizontal rays at y=300
    if (distToRay < 2.0 && pix.x > 100 && pix.x < 700) {
        rayIntensity = 0.5;
    }
    
    // Add ray color
    if (rayIntensity > 0.0) {
        color.rgb += vec3(rayIntensity);
        color.rgb = min(color.rgb, vec3(1.0));
    }
    
    imageStore(outImage, pix, color);
}
