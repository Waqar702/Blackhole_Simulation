#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) writeonly uniform image2D outImage;
layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    bool moving;
    int   _pad4;
} cam;

layout(std140, binding = 2) uniform Disk {
    float disk_r1;
    float disk_r2;
    float disk_num;
    float thickness;
};

layout(std140, binding = 3) uniform Objects {
    int numObjects;
    vec4 objPosRadius[16];
    vec4 objColor[16];
    float  mass[16]; 
};

const float SagA_rs = 1.269e10;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= 800 || pix.y >= 600) return;

    // Init Ray
    float u = (2.0 * (pix.x + 0.5) / 800.0 - 1.0) * cam.aspect * cam.tanHalfFov;
    float v = (1.0 - 2.0 * (pix.y + 0.5) / 600.0) * cam.tanHalfFov;
    vec3 dir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);
    
    vec4 color = vec4(0.0);
    
    // Start ray from camera
    vec3 rayPos = cam.camPos;
    vec3 rayVel = dir;
    
    // Simple ray marching
    bool hitBlackHole = false;
    bool hitDisk = false;
    
    for (int i = 0; i < 1000; ++i) {
        float distToOrigin = length(rayPos);
        
        // Check if we hit the black hole
        if (distToOrigin <= SagA_rs) {
            hitBlackHole = true;
            break;
        }
        
        // Check if we hit the accretion disk (y=0 plane)
        if (abs(rayPos.y) < 1e9 && distToOrigin >= disk_r1 && distToOrigin <= disk_r2) {
            hitDisk = true;
            break;
        }
        
        // Simple forward march
        rayPos += rayVel * 1e8;
        
        // Check if we've gone too far
        if (distToOrigin > 1e12) break;
    }
    
    // Color based on what we hit
    if (hitBlackHole) {
        color = vec4(0.0, 0.0, 0.0, 1.0);  // Black hole
    } else if (hitDisk) {
        float r = length(rayPos) / disk_r2;
        color = vec4(1.0, 0.3 + 0.7 * r, 0.1, 1.0);  // Orange disk
    } else {
        // Show starfield with fewer stars
        float noise = fract(sin(dot(vec2(pix), vec2(12.9898, 78.233))) * 43758.5453);
        if (noise > 0.995) {
            color = vec4(1.0, 1.0, 1.0, 1.0);  // White stars
        } else {
            color = vec4(0.0, 0.0, 0.3, 1.0);  // Dark blue background
        }
    }
    
    // Add multiple light rays coming from the left
    vec2 screenPos = vec2(pix.x, pix.y);
    
    // Create multiple horizontal light rays at different heights
    for (int ray = 0; ray < 8; ++ray) {
        float rayY = 100.0 + float(ray) * 60.0;  // Rays at y=100, 160, 220, etc.
        
        // Check if this pixel is near a ray path
        float distToRay = abs(screenPos.y - rayY);
        if (distToRay < 3.0 && screenPos.x > 50 && screenPos.x < 750) {
            // Add some curvature based on distance from black hole
            float centerX = 400.0;  // Center of screen
            float distFromCenter = abs(screenPos.x - centerX);
            float curvature = 0.0;
            
            // Add gravitational lensing effect
            if (distFromCenter < 200.0) {
                float bhInfluence = 1.0 - (distFromCenter / 200.0);
                curvature = bhInfluence * 20.0 * sin(screenPos.x * 0.01);
            }
            
            float curvedY = rayY + curvature;
            float distToCurvedRay = abs(screenPos.y - curvedY);
            
            if (distToCurvedRay < 2.0) {
                // Make rays more visible
                color.rgb = max(color.rgb, vec3(0.8, 0.9, 1.0));
            }
        }
    }
    
    imageStore(outImage, pix, color);
}
